{
  "name": "looptech",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node postbuild.js",
    "postbuild": "node postbuild.js",
    "serve:dist": "cd dist && npx http-server -p 8080 -c-1",
    "build:dev:android": "eas build --profile development --platform android",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:preview:universal": "eas build --profile preview-universal --platform android",
    "build:prod:android": "eas build --profile production --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:prod:ios": "eas build --profile production --platform ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-firebase/app": "^22.4.0",
    "@react-native-firebase/messaging": "^22.4.0",
    "@react-native-picker/picker": "^2.11.1",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.3.27",
    "@reduxjs/toolkit": "^2.9.0",
    "axios": "^1.12.2",
    "dayjs": "^1.11.18",
    "expo": "~53.0.22",
    "expo-asset": "^11.1.7",
    "expo-blur": "~14.1.5",
    "expo-build-properties": "~0.14.8",
    "expo-constants": "~17.1.7",
    "expo-dev-client": "~5.2.4",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-image": "^2.4.1",
    "expo-image-picker": "^16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.7",
    "expo-location": "~18.1.6",
    "expo-media-library": "~17.1.7",
    "expo-notifications": "~0.31.5",
    "expo-secure-store": "~14.2.4",
    "expo-splash-screen": "^0.30.10",
    "expo-video": "^2.2.2",
    "i18next": "^23.16.8",
    "jalaali-js": "^1.2.8",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-i18next": "^13.5.0",
    "react-native": "0.79.6",
    "react-native-confirmation-code-field": "^8.0.1",
    "react-native-gifted-charts": "^1.4.64",
